# Optional real Qwen configuration. Never commit real credentials.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Set true for deterministic local integration tests. The response is labelled
# MOCK_QWEN and no external model request is made.
MOCK_QWEN=false

# Optional persistent SQLite path for production-mounted storage.
# The local default remains C:\Users\HP\FinSight\data\finsight.db.
FINSIGHT_DB_PATH=
